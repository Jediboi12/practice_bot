<?xml version="1.0"?>


<robot name="practice_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="PI" value="3.14259"/>

    <link name="world"/>

    <link name="base_link">
        <visual>
            <origin rpy="${PI/2} 0.0 0.0" xyz="-0.5 0.5 0.0"/>
            <geometry>
                <mesh filename="package://practice_bot_description/meshes/base_link.STL" scale="0.007 0.007 0.007"/>
            </geometry>
        </visual>
      
    </link>

    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        
    </joint>

    <link name="robot_first_arm">
        <visual>
            <origin rpy="-${PI} 0 0" xyz="-0.86 -0.55 0.39"/>
            <geometry>
                <mesh filename="package://practice_bot_description/meshes/robot_first_arm.STL" scale="0.007 0.007 0.007"/>
            </geometry>
        </visual>
        
    </link>

    <joint name="robot_first_arm_joint" type="revolute">
        <parent link="base_link"/>
        <child link="robot_first_arm"/>
        <origin rpy="0 0 0" xyz="0.25 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
    </joint>

    <link name="robot_second_arm">
        <visual>
            <origin rpy="0 0 0" xyz="1.0 0.5 0.5"/>
            <geometry>
                <mesh filename="package://practice_bot_description/meshes/robot_second_arm.STL" scale="0.007 0.007 0.007"/>
            </geometry>
        </visual>
        
    </link>

    <joint name="robot_second_arm_joint" type="revolute">
        <parent link="robot_first_arm"/>
        <child link="robot_second_arm"/>
        <origin rpy="0 0 0" xyz="1.0 0.5 0.5"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
    </joint>
   
</robot>